running program: (OPTIM=true)

# batch size 1
data = Tensor.fill((1,784), f32(0))
weight1 = Tensor.fill((128,784), f32(0))
bias1 = Tensor.fill((1,128), f32(0))
layer1 = Linear(weight1, bias1)
# 784 -> 128
y1 = layer1.forward(data)
# relu
y2 = y1.relu()
weight2 = Tensor.fill((10,128), f32(0))
bias2 = Tensor.fill((1,10), f32(0))
layer2 = Linear(weight2, bias2)
# 128 -> 10
y3 = layer2.forward(y2)
# softmax
softmax = Softmax[f32]()
probs = softmax.forward(y3)
print(probs)

